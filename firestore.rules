rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ← نفس الإيميل اللي في OWNER_EMAIL جوه index.html
    function ownerEmail() { return 'khaledalhadedy001@gmail.com'; }

    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.token.email == ownerEmail(); }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return hasProfile() && me().active == true; }
    function member() { return isOwner() || active(); }
    function isSup() { return isOwner() || (active() && me().role == 'supervisor'); }   // مدير التشغيل
    function isMgr() { return active() && me().role == 'manager'; }                     // المدير العام
    function isEmp() { return active() && me().role == 'employee'; }
    function isKiosk() { return active() && me().role == 'kiosk'; }               // جهاز الحضور
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function noteKeys() { return ['updatedAt', 'lastUpdate', 'lastUpdateBy', 'lastUpdateAt']; }

    // حسابات المستخدمين: الكل يشوف الأسماء، ومدير التشغيل بس يضيف ويعدّل
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || member());
      allow create, update: if isSup();
      allow delete: if false;
    }

    // عدادات الأرقام
    match /meta/counter {
      allow read, write: if isSup() || isMgr();
    }
    match /meta/archiveCounter {
      allow read, write: if member();
    }
    match /meta/visaCounter {
      allow read, write: if isSup();
    }

    match /tasks/{taskId} {
      function assignee() { return resource.data.assignedTo == request.auth.uid; }
      function lender() { return resource.data.get('returnTo', '') == request.auth.uid; }
      // مهمة موزعة على أكتر من موظف: كل واحد ليه مسار جوه tracks واسمه في members
      function inTracks() { return request.auth.uid in resource.data.get('members', []); }
      function onlyMyTrack() {
        return !changed().hasAny(['tracks'])
          || (request.auth.uid in request.resource.data.tracks
              && request.resource.data.tracks.diff(resource.data.get('tracks', {})).affectedKeys().hasOnly([request.auth.uid]));
      }

      // تحويل جزء لزميل، أو إرجاعه للي حوّله
      function validHandoff() {
        return (resource.data.get('returnTo', '') == ''
                  && request.resource.data.returnTo == request.auth.uid
                  && request.resource.data.assignedTo != request.auth.uid
                  && get(/databases/$(database)/documents/users/$(request.resource.data.assignedTo)).data.role == 'employee')
            || (resource.data.get('returnTo', '') != ''
                  && request.resource.data.assignedTo == resource.data.returnTo
                  && request.resource.data.returnTo == '');
      }
      function validStatus() {
        return !changed().hasAny(['status'])
          || request.resource.data.status == 'in_progress'
          || (request.resource.data.status == 'pending_approval' && resource.data.get('returnTo', '') == '');
      }

      allow read: if isSup() || isMgr() || (isEmp() && (assignee() || lender() || inTracks()));

      // المدير العام بيبعت المهمة من غير توزيع، ومدير التشغيل يقدر يوزع على طول
      allow create: if (isSup() || isMgr())
        && request.resource.data.createdBy == request.auth.uid
        && (isSup() || (request.resource.data.status == 'new' && request.resource.data.assignedTo == ''));

      allow update: if isSup()
        // المدير العام: ملاحظات وربط ملفات
        || (isMgr() && changed().hasOnly(noteKeys().concat(['files'])))
        // الموظف المسؤول: يبدأ، يبعت للاعتماد، يطلب مد، يربط ملفات، يحوّل جزء أو يرجّعه
        || (isEmp() && assignee() && resource.data.status != 'closed'
            && changed().hasOnly(noteKeys().concat(['status', 'files', 'extReq', 'escalatedAt', 'assignedTo', 'assignedToName', 'returnTo', 'returnToName', 'handoffNote']))
            && validStatus()
            && (!changed().hasAny(['assignedTo']) || validHandoff()))
        // الموظف اللي حوّل جزء: ملاحظات وربط ملفات بس
        || (isEmp() && lender() && resource.data.status != 'closed'
            && changed().hasOnly(noteKeys().concat(['files'])))
        // موظف ليه مسار: يبدأ ويخلّص مساره هو بس، ويكتب ملاحظات ويربط ملفات ويطلب مد
        || (isEmp() && inTracks() && resource.data.status != 'closed'
            && changed().hasOnly(noteKeys().concat(['status', 'files', 'extReq', 'escalatedAt', 'tracks']))
            && onlyMyTrack()
            && (!changed().hasAny(['status']) || request.resource.data.status in ['in_progress', 'pending_approval']));

      allow delete: if isSup();

      function taskDoc() { return get(/databases/$(database)/documents/tasks/$(taskId)).data; }
      function canSeeTask() {
        return isSup() || isMgr()
          || (isEmp() && (taskDoc().assignedTo == request.auth.uid || taskDoc().get('returnTo', '') == request.auth.uid
                          || request.auth.uid in taskDoc().get('members', [])));
      }
      function canWorkTask() {
        return isSup()
          || (isEmp() && (taskDoc().assignedTo == request.auth.uid || taskDoc().get('returnTo', '') == request.auth.uid
                          || request.auth.uid in taskDoc().get('members', [])));
      }

      match /updates/{updateId} {
        allow read: if canSeeTask();
        allow create: if canSeeTask() && request.resource.data.by == request.auth.uid;
        allow update, delete: if false;
      }

      // كشف التحصيل (أسماء، نتيجة المكالمة، المدفوع)
      match /sheet/{rowId} {
        allow read: if canSeeTask();
        allow create, update, delete: if canWorkTask();
      }
    }

    // ===== الحضور والانصراف =====
    // الكود الحالي اللي على شاشة الشركة: الموظفين مايقدروش يقروه
    match /attKiosk/{doc} {
      allow read, write: if isSup() || isKiosk();
    }
    // موقع الشركة
    match /settings/{doc} {
      allow read: if member();
      allow write: if isSup();
    }
    match /attendance/{recId} {
      // الكود لازم يطابق اللي على الشاشة (صالح ٧٠ ثانية) أو الكود الثابت المطبوع، والموقع لازم يكون جوه نطاق الشركة
      function validScan(code, lat, lng) {
        let kp = /databases/$(database)/documents/attKiosk/current;
        let fp = /databases/$(database)/documents/attKiosk/fixed;
        let o = get(/databases/$(database)/documents/settings/office).data;
        return ((exists(kp) && code == get(kp).data.code && request.time < get(kp).data.at + duration.value(70, 's'))
                || (exists(kp) && code == get(kp).data.prev && request.time < get(kp).data.at + duration.value(30, 's'))
                || (exists(fp) && code == get(fp).data.code))   // الكود الثابت المطبوع (شغال لحد ما مدير التشغيل يغيّره)
          && math.abs(lat - o.lat) <= o.dLat && math.abs(lng - o.lng) <= o.dLng;
      }
      allow read: if isSup() || isMgr() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSup()
        || (member() && !isKiosk()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.inAt == request.time
            && !('outAt' in request.resource.data)
            && validScan(request.resource.data.inCode, request.resource.data.inLat, request.resource.data.inLng));
      allow update: if isSup()
        || (signedIn() && resource.data.uid == request.auth.uid && !('outAt' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outAt', 'outLat', 'outLng', 'outAcc', 'outCode'])
            && request.resource.data.outAt == request.time
            && validScan(request.resource.data.outCode, request.resource.data.outLat, request.resource.data.outLng));
      allow delete: if isSup();
    }

    // ===== التأشيرات =====
    // المسار: مراجعة الجوازات والصور (مدير التشغيل) ← التسجيل (regUid) ← التنفيذ والمتابعة (exeUid) ← صدرت ورجعت لمدير التشغيل ← اتسلمت
    match /visas/{vid} {
      function inFile() { return request.auth.uid in resource.data.get('people', []); }
      function vKeys(extra) { return changed().hasOnly(noteKeys().concat(extra)); }

      allow read: if isSup() || isMgr() || (isEmp() && inFile());
      allow create: if isSup() && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isSup();

      allow update: if isSup()
        // المدير العام: ملاحظات بس
        || (isMgr() && vKeys([]))
        // أي موظف في الملف: ملاحظات وربط ملفات من الأرشيف
        || (isEmp() && inFile() && vKeys(['files']))
        // اللي بيسجّل: يخلّص التسجيل فيروح للتنفيذ، أو يرجّعه لمدير التشغيل
        || (isEmp() && resource.data.stage == 'register' && resource.data.regUid == request.auth.uid
            && vKeys(['files', 'reg', 'stage', 'stageAt', 'registeredAt', 'backReason'])
            && request.resource.data.stage in ['register', 'execute', 'review'])
        // اللي بينفّذ: يحدّث الحالة، ولما تصدر أو تترفض الملف يرجع لمدير التشغيل
        || (isEmp() && resource.data.stage == 'execute' && resource.data.exeUid == request.auth.uid
            && vKeys(['files', 'status', 'platform', 'appRef', 'stage', 'stageAt', 'issuedAt', 'result', 'backReason'])
            && (request.resource.data.stage in ['execute', 'review']
                || (request.resource.data.stage == 'back' && request.resource.data.status in ['issued', 'rejected'])));

      function visaDoc() { return get(/databases/$(database)/documents/visas/$(vid)).data; }
      function canSeeVisa() { return isSup() || isMgr() || (isEmp() && request.auth.uid in visaDoc().get('people', [])); }
      match /log/{logId} {
        allow read: if canSeeVisa();
        allow create: if canSeeVisa() && request.resource.data.by == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ===== الرحلات: تأكيد انضمام المعتمرين للجروب =====
    // trips/{id}: بيانات الرحلة + people (الأسماء والجوازات) + joins (التأكيدات) — الإدارة بس تقراها
    match /trips/{tid} {
      allow read: if isSup() || isMgr();
      allow write: if isSup();
      match /people/{pid} {
        allow read: if isSup() || isMgr();
        allow write: if isSup();
      }
      // التمام (جرد المعتمرين قبل التحرك)
      match /checks/{cid} {
        allow read: if isSup() || isMgr();
        allow write: if isSup();
      }
      match /joins/{pid} {
        allow read: if isSup() || isMgr();
        allow create, update, delete: if isSup();
        // المعتمر من اللينك (من غير تسجيل دخول): رقم الجواز لازم يطابق المسجل والتسجيل مفتوح.
        // التأكيد مرة واحدة بس لكل معتمر (create بس) — ولو مدير التشغيل لغى التأكيد يقدر يأكد تاني. ومفيش قراءة للتأكيدات خالص
        function okJoin() {
          return request.resource.data.keys().hasOnly(['passport', 'phone', 'at'])
            && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 20))
            && request.resource.data.at == request.time
            && request.resource.data.passport is string
            && request.resource.data.passport.size() >= 5
            && exists(/databases/$(database)/documents/trips/$(tid)/people/$(pid))
            && request.resource.data.passport == get(/databases/$(database)/documents/trips/$(tid)/people/$(pid)).data.get('passport', '')
            && get(/databases/$(database)/documents/joinPub/$(tid)).data.open == true;
        }
        allow create: if okJoin();
      }
    }
    // joinPub/{id}: اللي بيظهر في صفحة المعتمر (العنوان وأرقام المشرفين — من غير أسماء)
    match /joinPub/{tid} {
      allow get: if true;
      allow list: if isSup() || isMgr();
      allow write: if isSup();
      // الأسماء متقسمة بالاسم الأول (رقم الوثيقة = بصمة الاسم الأول): لازم تكتب الاسم الأول صح عشان توصل لها، ومفيش عرض للقايمة كلها
      match /k/{h} {
        allow get: if true;
        allow list: if false;
        allow write: if isSup();
      }
      // ملف مسار الرحلة (أجزاء): أي حد معاه لينك الرحلة يفتحه، ومدير التشغيل بس يرفعه
      match /route/{part} {
        allow get: if true;
        allow list: if false;
        allow write: if isSup();
      }
      // فنادق كل معتمر: رقم الوثيقة = بصمة (الرحلة + المعتمر + رقم الجواز)، فمحدش يوصلها غير اللي معاه الجواز
      match /h/{x} {
        allow get: if true;
        allow list: if false;
        allow write: if isSup();
      }
      // قديم (من النسخة الأولى): مقفول، ومدير التشغيل بس يمسحه
      match /done/{pid} {
        allow read: if isSup() || isMgr();
        allow write: if isSup();
      }
    }

    // أرشيف الملفات
    match /archive/{ref} {
      allow read: if member();
      allow create: if member() && request.resource.data.by == request.auth.uid;
      allow update, delete: if isSup();
      match /chunks/{chunkId} {
        allow read, create: if member();
        allow update, delete: if isSup();
      }
    }
  }
}
