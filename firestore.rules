rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ← نفس الإيميل اللي في OWNER_EMAIL جوه index.html
    function ownerEmail() { return 'khaledalhadedy001@gmail.com'; }

    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.token.email == ownerEmail(); }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return hasProfile() && me().active == true; }
    function member() { return isOwner() || active(); }
    function isSup() { return isOwner() || (active() && me().role == 'supervisor'); }   // مدير التشغيل
    function isMgr() { return active() && me().role == 'manager'; }                     // المدير العام
    function isEmp() { return active() && me().role == 'employee'; }
    function isKiosk() { return active() && me().role == 'kiosk'; }               // جهاز الحضور
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function noteKeys() { return ['updatedAt', 'lastUpdate', 'lastUpdateBy', 'lastUpdateAt']; }

    // حسابات المستخدمين: الكل يشوف الأسماء، ومدير التشغيل بس يضيف ويعدّل
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || member());
      allow create, update: if isSup();
      allow delete: if false;
    }

    // عدادات الأرقام
    match /meta/counter {
      allow read, write: if isSup() || isMgr();
    }
    match /meta/archiveCounter {
      allow read, write: if member();
    }

    match /tasks/{taskId} {
      function assignee() { return resource.data.assignedTo == request.auth.uid; }
      function lender() { return resource.data.get('returnTo', '') == request.auth.uid; }
      // مهمة موزعة على أكتر من موظف: كل واحد ليه مسار جوه tracks واسمه في members
      function inTracks() { return request.auth.uid in resource.data.get('members', []); }
      function onlyMyTrack() {
        return !changed().hasAny(['tracks'])
          || (request.auth.uid in request.resource.data.tracks
              && request.resource.data.tracks.diff(resource.data.get('tracks', {})).affectedKeys().hasOnly([request.auth.uid]));
      }

      // تحويل جزء لزميل، أو إرجاعه للي حوّله
      function validHandoff() {
        return (resource.data.get('returnTo', '') == ''
                  && request.resource.data.returnTo == request.auth.uid
                  && request.resource.data.assignedTo != request.auth.uid
                  && get(/databases/$(database)/documents/users/$(request.resource.data.assignedTo)).data.role == 'employee')
            || (resource.data.get('returnTo', '') != ''
                  && request.resource.data.assignedTo == resource.data.returnTo
                  && request.resource.data.returnTo == '');
      }
      function validStatus() {
        return !changed().hasAny(['status'])
          || request.resource.data.status == 'in_progress'
          || (request.resource.data.status == 'pending_approval' && resource.data.get('returnTo', '') == '');
      }

      allow read: if isSup() || isMgr() || (isEmp() && (assignee() || lender() || inTracks()));

      // المدير العام بيبعت المهمة من غير توزيع، ومدير التشغيل يقدر يوزع على طول
      allow create: if (isSup() || isMgr())
        && request.resource.data.createdBy == request.auth.uid
        && (isSup() || (request.resource.data.status == 'new' && request.resource.data.assignedTo == ''));

      allow update: if isSup()
        // المدير العام: ملاحظات وربط ملفات
        || (isMgr() && changed().hasOnly(noteKeys().concat(['files'])))
        // الموظف المسؤول: يبدأ، يبعت للاعتماد، يطلب مد، يربط ملفات، يحوّل جزء أو يرجّعه
        || (isEmp() && assignee() && resource.data.status != 'closed'
            && changed().hasOnly(noteKeys().concat(['status', 'files', 'extReq', 'escalatedAt', 'assignedTo', 'assignedToName', 'returnTo', 'returnToName', 'handoffNote']))
            && validStatus()
            && (!changed().hasAny(['assignedTo']) || validHandoff()))
        // الموظف اللي حوّل جزء: ملاحظات وربط ملفات بس
        || (isEmp() && lender() && resource.data.status != 'closed'
            && changed().hasOnly(noteKeys().concat(['files'])))
        // موظف ليه مسار: يبدأ ويخلّص مساره هو بس، ويكتب ملاحظات ويربط ملفات ويطلب مد
        || (isEmp() && inTracks() && resource.data.status != 'closed'
            && changed().hasOnly(noteKeys().concat(['status', 'files', 'extReq', 'escalatedAt', 'tracks']))
            && onlyMyTrack()
            && (!changed().hasAny(['status']) || request.resource.data.status in ['in_progress', 'pending_approval']));

      allow delete: if isSup();

      function taskDoc() { return get(/databases/$(database)/documents/tasks/$(taskId)).data; }
      function canSeeTask() {
        return isSup() || isMgr()
          || (isEmp() && (taskDoc().assignedTo == request.auth.uid || taskDoc().get('returnTo', '') == request.auth.uid
                          || request.auth.uid in taskDoc().get('members', [])));
      }
      function canWorkTask() {
        return isSup()
          || (isEmp() && (taskDoc().assignedTo == request.auth.uid || taskDoc().get('returnTo', '') == request.auth.uid
                          || request.auth.uid in taskDoc().get('members', [])));
      }

      match /updates/{updateId} {
        allow read: if canSeeTask();
        allow create: if canSeeTask() && request.resource.data.by == request.auth.uid;
        allow update, delete: if false;
      }

      // كشف التحصيل (أسماء، نتيجة المكالمة، المدفوع)
      match /sheet/{rowId} {
        allow read: if canSeeTask();
        allow create, update, delete: if canWorkTask();
      }
    }

    // ===== الحضور والانصراف =====
    // الكود الحالي اللي على شاشة الشركة: الموظفين مايقدروش يقروه
    match /attKiosk/{doc} {
      allow read, write: if isSup() || isKiosk();
    }
    // موقع الشركة
    match /settings/{doc} {
      allow read: if member();
      allow write: if isSup();
    }
    match /attendance/{recId} {
      // الكود لازم يطابق اللي على الشاشة (صالح ٧٠ ثانية)، والموقع لازم يكون جوه نطاق الشركة
      function validScan(code, lat, lng) {
        let k = get(/databases/$(database)/documents/attKiosk/current).data;
        let o = get(/databases/$(database)/documents/settings/office).data;
        return ((code == k.code && request.time < k.at + duration.value(70, 's'))
                || (code == k.prev && request.time < k.at + duration.value(30, 's')))
          && math.abs(lat - o.lat) <= o.dLat && math.abs(lng - o.lng) <= o.dLng;
      }
      allow read: if isSup() || isMgr() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSup()
        || (member() && !isKiosk()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.inAt == request.time
            && !('outAt' in request.resource.data)
            && validScan(request.resource.data.inCode, request.resource.data.inLat, request.resource.data.inLng));
      allow update: if isSup()
        || (signedIn() && resource.data.uid == request.auth.uid && !('outAt' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outAt', 'outLat', 'outLng', 'outAcc', 'outCode'])
            && request.resource.data.outAt == request.time
            && validScan(request.resource.data.outCode, request.resource.data.outLat, request.resource.data.outLng));
      allow delete: if isSup();
    }

    // أرشيف الملفات
    match /archive/{ref} {
      allow read: if member();
      allow create: if member() && request.resource.data.by == request.auth.uid;
      allow update, delete: if isSup();
      match /chunks/{chunkId} {
        allow read, create: if member();
        allow update, delete: if isSup();
      }
    }
  }
}
